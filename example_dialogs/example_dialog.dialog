label start

# character names
set alice "[color=red]Alice[/color]"
set mary "[color=green]Mary[/color]"

# character sprites
set alice_happy "res://example_assets/alice_happy.png"
set alice_sad "res://example_assets/alice_sad.png"

set mary_iddle "res://example_assets/mary_idle.png"
set mary_happy "res://example_assets/mary_happy.png"

# backgrounds
set black_screen "res://example_assets/black_screen.png"
set school "res://example_assets/school.png"

# sfx
set alice_voice_1 "res://example_assets/alice_voice_1.wav"
set alice_voice_2 "res://example_assets/alice_voice_2.wav"
set mary_voice_1 "res://example_assets/mary_voice_1.wav"

# bg music
set bg_music_1 "res://example_assets/bg_music_1.wav"

play_music bg_music_1 fade

background black_screen

wait 1.5

speaker _

	Welcome to the example dialog!
	This dialog is meant to show the different features of the dialog system.

hide_dialog

background school

show alice happy center

play_sound alice_voice_1

speaker alice

	Hi there! I'm {alice}, and I'm happy to see you!
	I can also be sad, angry, or surprised!

hide_dialog

update alice sad

play_sound alice_voice_2

wait 1.0

	See? Now I'm sad!

hide_dialog

move alice left

show mary iddle right

play_sound mary_voice_1

speaker mary

	Hi {alice}! I'm {mary}.
	I can also be happy, sad, angry, or surprised!

update mary happy

	See? Now I'm happy!

speaker _

	You can also make choices in the dialog!
	For example, you can choose to ask {alice} how she's doing or to say goodbye.

choose

	How are you? -> ask_alice
	Goodbye! -> goodbye

label ask_alice

play_sound alice_voice_1

speaker alice

	I'm doing great! Thanks for asking!

jump end

label goodbye

speaker alice

	Goodbye! It was nice talking to you!

speaker mary

	Goodbye! See you later!

jump end

label end

speaker _

hide_dialog

hide alice
hide mary

	This is the end of the example dialog. Thanks for watching!

hide_dialog

background black_screen

stop_music fade

wait 4.0

background none
