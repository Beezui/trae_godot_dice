script = """
extends Control

var dice_manager

func _ready():
	dice_manager = $DiceManager
	
	# 连接按钮信号
	$VBoxContainer/HBoxContainer/NormalButton.pressed.connect(func(): set_scene("normal"))
	$VBoxContainer/HBoxContainer/SkillButton.pressed.connect(func(): set_scene("skill"))
	$VBoxContainer/HBoxContainer/TestButton.pressed.connect(test_custom_config)

func set_scene(scene_name: String):
	# 切换场景配置
	dice_manager.set_scene_config(scene_name)
	# 更新标签
	$VBoxContainer/ResultLabel.text = "Current Scene: " + scene_name

func test_custom_config():
	# 测试自定义配置
	var custom_config = {
		0: "res://textures/dice/dice_face_6.png",
		1: "res://textures/dice/dice_face_5.png",
		2: "res://textures/dice/dice_face_4.png",
		3: "res://textures/dice/dice_face_3.png",
		4: "res://textures/dice/dice_face_2.png",
		5: "res://textures/dice/dice_face_1.png"
	}
	
	# 应用自定义配置到第一个骰子
	var dice = dice_manager.get_dice(0)
	if dice and dice.has_method("set_dice_face_config"):
		dice.set_dice_face_config(custom_config)
		$VBoxContainer/ResultLabel.text = "Applied custom config to first dice"
"""

