[node name="Script" type="Script" parent="Control"]
script = """
extends Control

var dice_face_manager

func _ready():
	print("Test CSV Simple scene loaded")
	
	# 初始化骰子面管理器
	print("Loading DiceFaceManager...")
	dice_face_manager = preload("res://scripts/dice_face_manager.gd").new()
	print("DiceFaceManager loaded")
	
	# 连接按钮信号
	print("Connecting button signal...")
	$VBoxContainer/Button.pressed.connect(load_csv)
	print("Button signal connected")
	
	# 初始加载
	print("Loading CSV data...")
	load_csv()
	print("CSV data loaded")

func load_csv():
	print("Reloading CSV file...")
	
	# 加载CSV文件
	dice_face_manager.reload()
	
	# 显示CSV数据
	var info = "CSV Data:\n"
	info += "All face IDs: " + str(dice_face_manager.get_all_face_ids()) + "\n"
	
	# 显示每个ID对应的贴图路径
	for id in dice_face_manager.get_all_face_ids():
		var path = dice_face_manager.get_texture_path_by_id(id)
		var desc = dice_face_manager.get_description_by_id(id)
		info += "ID " + str(id) + ": " + path + " (" + desc + ")\n"
	
	print("CSV data: " + info)
	$VBoxContainer/Label.text = info
"""
