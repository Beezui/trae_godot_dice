extends Node3D

@onready var dice = $Dice6
@onready var player = $Characters/Player
@onready var enemy = $Characters/Enemy

var battle_state = "ready"  # ready, rolling, resolving, ended
var is_charging = false
var charge_start_time = {}
var max_charge_time = 2.0  # 最大蓄力时间
var max_force = 50.0  # 最大投掷力度
var dice_height = 1.0  # 骰子高度
var original_dice_position = Vector3(0, 5, 0)  # 骰子初始位置
var charge_duration = 0.0  # 当前蓄力时间
var timer: Timer  # 声明timer变量

func _ready():
	# 检查骰子是否存在
	if dice:
		# 设置骰子初始位置
		dice.position = original_dice_position
		dice.linear_velocity = Vector3.ZERO
		dice.angular_velocity = Vector3.ZERO
	else:
		print("Error: Dice not found!")

func _input(event):
	# 空格键按下开始蓄力
	if event is InputEventKey and event.keycode == KEY_SPACE:
		if event.pressed:
			if battle_state == "ready":
				start_charging()
		else:
			if is_charging:
				release_charge()
	# R键收回骰子
	elif event is InputEventKey and event.keycode == KEY_R and event.pressed:
		if battle_state != "ready":
			reset_dice()
			battle_state = "ready"
			print("骰子已收回")

func start_charging():
	is_charging = true
	charge_start_time = Time.get_time_dict_from_system()
	charge_duration = 0.0
	print("开始蓄力...")

func release_charge():
	is_charging = false
	if charge_start_time.size() == 0:
		print("Error: Charge start time not set!")
		return
	
	var current_time = Time.get_time_dict_from_system()
	# 计算蓄力时间（秒）
	var start_time = charge_start_time["second"] + charge_start_time["minute"] * 60 + charge_start_time["hour"] * 3600
	var end_time = current_time["second"] + current_time["minute"] * 60 + current_time["hour"] * 3600
	charge_duration = end_time - start_time
	if charge_duration < 0:
		charge_duration += 86400  # 处理跨天的情况
	
	# 计算蓄力时间，限制在0到max_charge_time之间
	charge_duration = clamp(charge_duration, 0, max_charge_time)
	
	# 根据蓄力时间计算投掷力度
	var force_multiplier = charge_duration / max_charge_time
	var force = force_multiplier * max_force
	
	print("蓄力时间: %s秒, 投掷力度: %s" % [charge_duration, force])
	
	# 开始投掷
	start_roll(force)

func start_roll(force_value):
	# 检查骰子是否存在
	if not dice:
		print("Error: Dice not found!")
		return
	
	battle_state = "rolling"
	
	# 根据力度值创建力向量
	var force = Vector3(
		randf_range(-force_value * 0.3, force_value * 0.3),  # 水平方向随机力
		force_value,  # 垂直方向力
		randf_range(-force_value * 0.2, force_value * 0.2)  # 前后方向随机力
	)
	
	# 投掷骰子（使用当前位置，不重置位置）
	dice.linear_velocity = force
	dice.angular_velocity = Vector3(randf_range(-10, 10), randf_range(-10, 10), randf_range(-10, 10))
	
	# 等待骰子停止后处理结果
	timer = Timer.new()
	timer.wait_time = 4.0
	timer.one_shot = true
	timer.timeout.connect(_on_roll_finished)
	add_child(timer)
	timer.start()

func _on_roll_finished():
	# 检查骰子是否存在
	if not dice:
		print("Error: Dice not found!")
		return
	
	battle_state = "resolving"
	
	# 处理骰子结果
	var dice_value = dice.dice_value
	print("Battle dice rolled: ", dice_value)
	
	# 模拟战斗结果
	resolve_battle(dice_value)
	
	# 不自动重置状态，等待玩家按下R键收回骰子
	print("骰子已停止，请按R键收回骰子")

func resolve_battle(dice_value):
	# 根据骰子点数计算伤害
	var damage = dice_value * 5
	print("Player attacks with damage: ", damage)
	
	# 这里可以添加更复杂的战斗逻辑
	# 例如：根据技能类型、目标状态等计算最终伤害

func _reset_battle():
	battle_state = "ready"
	print("Battle reset, ready for next roll")

func _process(delta):
	# 处理蓄力时的颤抖效果
	if is_charging and charge_start_time.size() > 0 and dice:
		var current_time = Time.get_time_dict_from_system()
		# 计算蓄力时间（秒）
		var start_time = charge_start_time["second"] + charge_start_time["minute"] * 60 + charge_start_time["hour"] * 3600
		var end_time = current_time["second"] + current_time["minute"] * 60 + current_time["hour"] * 3600
		charge_duration = end_time - start_time
		if charge_duration < 0:
			charge_duration += 86400  # 处理跨天的情况
		charge_duration = clamp(charge_duration, 0, max_charge_time)
		
		# 计算颤抖幅度，与蓄力大小同步
		var shake_intensity = charge_duration / max_charge_time * 0.1
		
		# 计算颤抖偏移量
		var shake_offset = Vector3(
			randf_range(-shake_intensity, shake_intensity),
			randf_range(-shake_intensity, shake_intensity),
			randf_range(-shake_intensity, shake_intensity)
		)
		
		# 应用颤抖效果
		dice.position = original_dice_position + shake_offset
	
	# 更新战斗状态
	if battle_state == "rolling":
		# 可以添加一些视觉反馈
		pass

func reset_dice():
	# 检查骰子是否存在
	if dice:
		# 重置骰子位置
		dice.position = original_dice_position
		dice.linear_velocity = Vector3.ZERO
		dice.angular_velocity = Vector3.ZERO
	else:
		print("Error: Dice not found!")
